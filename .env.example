# MongoDB Atlas ulanish satri. Lokal sinov uchun: MONGODB_URI=memory (vaqtinchalik, saqlanmaydi)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/learn_clone

# @BotFather dan olingan token
BOT_TOKEN=

# Botdan foydalana oladigan Telegram ID lar (vergul bilan). Bo'sh qoldirilsa — hamma.
ADMIN_IDS=

# Sayt manzili. Render'da avtomatik RENDER_EXTERNAL_URL olinadi, shuning uchun bo'sh qoldiring.
PUBLIC_URL=

# Webhook uchun ixtiyoriy maxfiy so'z (faqat A-Z a-z 0-9 _ -)
WEBHOOK_SECRET=

PORT=3000
