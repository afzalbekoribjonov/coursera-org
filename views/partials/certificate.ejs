<%# Sertifikat: konteyner kengligiga qarab masshtablanadi (cqw birliklari) %>
<div class="cert-wrap">
  <div class="cert">
    <div class="cert__guilloche" aria-hidden="true"></div>

    <div class="cert__main">
      <div class="cert__logo" role="img" aria-label="Google Cloud">
        <span class="cert__google" aria-hidden="true"><span class="cert__google-blue">G</span><span class="cert__google-red">o</span><span class="cert__google-yellow">o</span><span class="cert__google-blue">g</span><span class="cert__google-green">l</span><span class="cert__google-red">e</span></span>
        <span class="cert__logo-cloud">Cloud</span>
      </div>

      <div class="cert__date"><%= formatDate(cert.completedAt, 'short') %></div>
      <div class="cert__name"><%= cert.fullName %></div>
      <div class="cert__small">has successfully completed</div>
      <div class="cert__course"><%= cert.courseTitle %></div>
      <div class="cert__small">an online non-credit course offered through Coursera</div>

      <div class="cert__sign">
        <div class="cert__signature">GoogleCloudTraining</div>
        <div class="cert__sign-line"></div>
      </div>
    </div>

    <div class="cert__ribbon">
      <div class="cert__ribbon-title">COURSE<br>CERTIFICATE</div>
      <svg class="cert__seal" viewBox="0 0 200 200" aria-hidden="true">
        <defs>
          <path id="sealCircle" d="M100,100 m-72,0 a72,72 0 1,1 144,0 a72,72 0 1,1 -144,0"/>
        </defs>
        <circle cx="100" cy="100" r="96" fill="#fff" stroke="#4a4f57" stroke-width="2"/>
        <circle cx="100" cy="100" r="88" fill="none" stroke="#4a4f57" stroke-width="1" stroke-dasharray="2 3"/>
        <circle cx="100" cy="100" r="56" fill="#fff" stroke="#4a4f57" stroke-width="3"/>
        <text font-family="Source Sans 3, sans-serif" font-size="15" letter-spacing="3" fill="#4a4f57" font-weight="600">
          <textPath href="#sealCircle">EDUCATION FOR EVERYONE . COURSE CERTIFICATE</textPath>
        </text>
        <text x="100" y="108" text-anchor="middle" font-family="Source Sans 3, sans-serif" font-size="23" font-weight="700" fill="#1f2328">coursera</text>
      </svg>
    </div>

    <div class="cert__verify">
      Verify at:<br>
      <span class="cert__verify-link"><%= verifyLink %></span><br>
      <span class="cert__verify-note">Issued by Coursera to the person named above.</span>
    </div>

    <div class="cert__footer">
      This certificate attests to the learner&#8217;s completion of an online course / project delivered via Coursera. It does not constitute formal enrollment at any university or entity and does not itself grant academic credit, grades,
      or a degree. Institutions or organizations may, at their discretion, recognize this learning toward their own programs or credentials
    </div>
  </div>
</div>
